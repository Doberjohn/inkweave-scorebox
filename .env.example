# Per-rarity point values. All optional; each falls back to the canonical
# Lorcana Core scoring if unset. Set these in Vercel (Project Settings →
# Environment Variables) or in a local .env.local for development.
#
# All values must be integers.

VITE_POINTS_FOIL_RARE=1
VITE_POINTS_SUPER_RARE=2
VITE_POINTS_FOIL_SUPER_RARE=4
VITE_POINTS_LEGENDARY=4
VITE_POINTS_EPIC=5
VITE_POINTS_FOIL_LEGENDARY=8
VITE_POINTS_ENCHANTED=12
VITE_POINTS_ICONIC=25
